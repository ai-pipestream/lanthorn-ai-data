    "jewel-of-knowledge": {
      "observed_at": "2026-09-25T08:54:00.202977+00:00",
      "session_id": "jewel-of-knowledge-61db1c70d2",
      "current_branch_id": "b3",
      "latest_event_id": "jewel-of-knowledge-61db1c70d2:e00425",
