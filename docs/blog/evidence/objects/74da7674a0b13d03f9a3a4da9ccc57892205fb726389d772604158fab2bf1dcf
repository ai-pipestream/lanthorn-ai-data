        for gid in local_ids[4:]+[f'remote-{i}' for i in range(24)]:
            manifest={**template_manifest,'game_id':gid,'session_id':gid+'-sid'}
            event={**template_event,'game_id':gid,'session_id':gid+'-sid','event_id':gid+'-sid:e1'}
